{
  "info": {
    "_postman_id": "a8911c84-1958-45a2-a563-70bcbf57cd98",
    "name": "PoliLink - Backend actual",
    "description": "Colección para los endpoints implementados. Ejecuta primero Obtener cookie CSRF antes de POST, PATCH o DELETE. Inscripciones no están incluidas porque Darwin aún no las implementa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "xsrfToken", "value": "" },
    { "key": "email", "value": "gatumbac@espol.edu.ec" },
    { "key": "firstName", "value": "Gabriel" },
    { "key": "lastName", "value": "Tumbaco" },
    { "key": "newStudentEmail", "value": "cambia-este-correo@example.test" },
    { "key": "newCommunityName", "value": "Comunidad Gabriel Agosto" },
    { "key": "password", "value": "password" },
    { "key": "communityId", "value": "1" },
    { "key": "eventCategoryId", "value": "3" },
    { "key": "eventModalityId", "value": "1" },
    { "key": "locationId", "value": "1" },
    { "key": "eventId", "value": "1" }
  ],
  "event": [],
  "item": [
    {
      "name": "00. Público",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
        { "name": "Catálogo de eventos", "request": { "method": "GET", "url": "{{baseUrl}}/api/events?per_page=12" } },
        { "name": "Filtrar eventos para captura", "request": { "method": "GET", "url": "{{baseUrl}}/api/events?category=hackathon&per_page=12" } },
        { "name": "Detalle del evento creado", "request": { "method": "GET", "url": "{{baseUrl}}/api/events/{{eventId}}" } },
        { "name": "Categorías", "request": { "method": "GET", "url": "{{baseUrl}}/api/event-categories" } },
        { "name": "Modalidades", "request": { "method": "GET", "url": "{{baseUrl}}/api/event-modalities" } },
        { "name": "Ubicaciones", "request": { "method": "GET", "url": "{{baseUrl}}/api/locations" } },
        { "name": "Comunidades públicas", "request": { "method": "GET", "url": "{{baseUrl}}/api/communities" } }
      ]
    },
    {
      "name": "01. Autenticación y CSRF",
      "item": [
        {
          "name": "Obtener cookie CSRF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" }
            ],
            "url": "{{baseUrl}}/sanctum/csrf-cookie"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.cookies.get('XSRF-TOKEN');",
                  "pm.test('Laravel devolvió la cookie XSRF-TOKEN', () => {",
                  "  pm.expect(token, 'Revisa Cookies para localhost en Postman').to.exist;",
                  "});",
                  "if (token) {",
                  "  pm.collectionVariables.set('xsrfToken', decodeURIComponent(token));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar estudiante nuevo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"{{firstName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"email\": \"{{newStudentEmail}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login Gabriel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Sesión actual",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "02. Comunidad y eventos autenticados",
      "item": [
        {
          "name": "Crear mi comunidad y obtener rol organizador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{newCommunityName}}\",\n  \"description\": \"Comunidad creada desde Postman para probar PoliLink.\"\n}" },
            "url": "{{baseUrl}}/api/communities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const community = pm.response.json().data;",
                  "if (community?.id) pm.collectionVariables.set('communityId', String(community.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis comunidades",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" }
            ],
            "url": "{{baseUrl}}/api/me/communities"
          }
        },
        {
          "name": "Mis eventos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" }
            ],
            "url": "{{baseUrl}}/api/me/events?per_page=12"
          }
        },
        {
          "name": "Crear evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('eventId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"community_id\": {{communityId}},\n  \"event_category_id\": {{eventCategoryId}},\n  \"event_modality_id\": {{eventModalityId}},\n  \"location_id\": {{locationId}},\n  \"title\": \"Taller Postman {{$timestamp}}\",\n  \"description\": \"Evento creado para probar la API.\",\n  \"starts_at\": \"2026-12-01T10:00:00-05:00\",\n  \"capacity\": 30\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Editar evento creado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Descripción actualizada desde Postman.\"\n}" },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Cancelar evento creado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Referer", "value": "http://localhost:5173/" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "url": "{{baseUrl}}/api/events/{{eventId}}/cancel"
          }
        }
      ]
    }
  ]
}
